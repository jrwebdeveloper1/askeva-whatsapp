{
    "name": "jrwebdeveloper1/askeva-whatsapp",
    "description": "AskEva WhatsApp API Integration for Laravel",
    "keywords": ["laravel", "whatsapp", "askeva", "api", "webhook"],
    "license": "MIT",
    "authors": [
        {
            "name": "jrwebdeveloper1"
        }
    ],
    "type": "library",
    "require": {
        "php": "^8.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Askeva\\WhatsApp\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Askeva\\WhatsApp\\AskEvaServiceProvider"
            ],
            "aliases": {
                "AskEva": "Askeva\\WhatsApp\\Facades\\AskEva"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
